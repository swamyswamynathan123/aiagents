OPENAI_API_KEY=sk-...
TAVILY_API_KEY=tvly-...
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=lsv2_...
LANGCHAIN_PROJECT=aiagents-demo
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# Optional model overrides (OpenAI chat models; all default to gpt-4o-mini)
# AGENT_MODEL=gpt-4o-mini        # every agent: the 16 patterns (both frameworks) and the 3 capstones
# EVAL_JUDGE_MODEL=gpt-4o-mini   # LLM judge in evals; keep it fixed when comparing AGENT_MODELs
# GUARDRAIL_MODEL=gpt-4o-mini    # optional LLM prompt-injection classifier
